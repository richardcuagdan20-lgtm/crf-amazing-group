---
import Base from "../layouts/Base.astro";
---
<Base title="About Us" description="Crystal Flores, founder of CRF Amazing Group. International Marketing Associate Director, Robinsons Land Corporation International Marketing.">
  <section class="page-intro">
    <div class="wrap">
      <p class="kicker">Commit, Raise and Forward</p>
      <h1>About Crystal Flores</h1>
      <p>
        Crystal Flores is the founder of CRF Amazing Group and of Global CRF Amazing —
        Global Real Estate Ambassadors and Global Marketing Partners.
      </p>
      <p>
        She is International Marketing Associate Director, Robinsons Land Corporation International Marketing.
        She has fourteen years of experience in real estate and ten years as a global business leader.
        She is a Philippine Registered Nurse and an Accredited Real Estate Salesperson.
      </p>
      <blockquote>
        “Driven by passion and built on innovation. We create with purpose to help you shape a better future today.”
      </blockquote>
      <p>
        Crystal helps Filipino homebuyers, OFWs, and international clients consider homes under
        RLC Residences — with a direct line on Viber, WhatsApp, a call, or email, not a ticket queue.
      </p>
    </div>
  </section>

  <section style="border-top:1px solid var(--line);">
    <div class="wrap">
      <h2>Global CRF teams</h2>
      <p class="lede">Crystal’s teams work with buyers and partners already living in these countries.</p>
      <ul class="teams">
        <li>Global CRF Canada</li>
        <li>Global CRF UAE</li>
        <li>Global CRF Spain</li>
        <li>Global CRF USA</li>
      </ul>
      <p style="margin-top:1.25rem;">You may also see her work under IM Amazing International Marketing.</p>
      <p>
        This is Crystal’s site, not the official RLC Residences website.
      </p>
      <div class="hero-actions" style="margin-top:1rem;">
        <a class="btn btn-navy" href="/contact">Contact Crystal</a>
        <a class="btn btn-line" href="/careers">Join the team</a>
      </div>
    </div>
  </section>
</Base>
