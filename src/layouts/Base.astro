---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyContact from "../components/StickyContact.astro";
import { withBase } from "../utils/paths.js";

const {
  title,
  description = "CRF Amazing Group, led by Crystal Flores — homes with RLC Residences, and a direct line on Viber, WhatsApp, or a call.",
} = Astro.props;
const pageTitle = title ? `${title} · CRF Amazing Group` : "CRF Amazing Group · Crystal Flores";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1C3A" />
    <title>{pageTitle}</title>
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyContact />
  </body>
</html>
